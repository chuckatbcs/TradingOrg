# Autonomous Trading Firm configuration
# Copy to .env or source alongside your TradingAgents .env

# Trading mode: paper (default) or live
FIRM_TRADING_MODE=paper
# Live auto-execute is blocked unless explicitly enabled
FIRM_ALLOW_LIVE_AUTO_EXECUTE=false

# Alpaca paper keys (https://alpaca.markets)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Risk limits (moderate defaults)
FIRM_MAX_POSITIONS=15
FIRM_MAX_POSITION_PCT=0.05
FIRM_DAILY_LOSS_LIMIT_PCT=0.03
FIRM_RISK_PER_TRADE=0.012

# Hybrid fusion
FIRM_QUANT_MIN_SCORE=60
FIRM_FUSION_ENTRY_THRESHOLD=0.5

# Screener filter thresholds (tune when no candidates pass)
# FIRM_SCREENER_ADX_MIN=20
# FIRM_SCREENER_RSI_LOW=30
# FIRM_SCREENER_RSI_HIGH=70
# FIRM_SCREENER_VOLUME_RATIO_MIN=1.2
# FIRM_SCREENER_MODE=scoring

# Universe mode: watchlist (default, ~50 tickers) or market (multi-scan union stage 1)
# FIRM_UNIVERSE_MODE=watchlist
# FIRM_MARKET_SCREENER_MAX=200
# FIRM_MARKET_SCREENER_MIN_PRICE=5.0
# FIRM_MARKET_SCREENER_ACTIVES_TOP=100
# FIRM_MARKET_SCREENER_INCLUDE_ACTIVES=true
# FIRM_MARKET_SCREENER_INCLUDE_ACTIVES_BY_TRADES=true
# FIRM_MARKET_SCREENER_INCLUDE_MOVERS=true
# FIRM_MARKET_SCREENER_MOVERS_MIN_PCT=2.0
# FIRM_MARKET_SCREENER_INCLUDE_WATCHLIST=true
# FIRM_MARKET_SCREENER_INCLUDE_SPY_HOLDINGS=false
# FIRM_MARKET_SCREENER_SPY_HOLDINGS_TOP=15

# Scheduler (America/New_York) — requires pip install ".[firm]"
FIRM_SCHEDULER_ENABLED=false
FIRM_PREMARKET_SCREEN_TOP_N=5

# Optional Discord alerts
DISCORD_WEBHOOK_URL=

# Storage (default: ~/.tradingagents/firm/)
# FIRM_DATA_DIR=

# UI-tunable settings are also saved to ~/.tradingagents/firm/user_settings.json
# when changed in the Firm tab (web UI). Environment variables override file values
# for the same keys. Secrets (Alpaca keys, live mode) are never written from the UI.
